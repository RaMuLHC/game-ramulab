    instruction: "Swap column spans of Foundry VTT and Discord Server blocks; embed Discord widget in Discord block"
    replacement_infos {
      original_chunk {
        target_content: "      {/* Foundry VTT Server console card (7 cols) */}\n      <motion.div \n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.5 }}\n        className=\"lg:col-span-7 relative bg-slate-900/85 border border-purple-500/30 rounded-2xl p-6 backdrop-blur-md shadow-[0_0_20px_rgba(168,85,247,0.15)] flex flex-col justify-between group\"\n      >\n        <div className=\"absolute top-0 right-0 w-24 h-24 bg-purple-500/10 rounded-full blur-2xl pointer-events-none\" />\n        \n        <div>\n          {/* Header */}\n          <div className=\"flex justify-between items-center mb-5\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-2 bg-purple-950/50 rounded-xl border border-purple-500/30 text-purple-400 group-hover:scale-105 transition-transform duration-350\">\n                <Dices size={20} />\n              </div>\n              <div>\n                <h2 className=\"text-lg font-sans font-bold text-slate-100\">Foundry VTT \350\267\221\345\234\230\344\274\272\346\234\215\345\231\250</h2>\n                <p className=\"text-xs text-slate-400 font-mono\">Foundry Virtual Tabletop Server Node</p>\n              </div>\n            </div>\n            \n            {/* Table status indicator */}\n            <div className=\"flex items-center gap-2 bg-emerald-950/40 px-2.5 py-1 rounded-full border border-emerald-500/30\">\n              <span className=\"h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n              <span className=\"text-[10px] font-mono text-emerald-400 uppercase tracking-widest font-semibold\">Active</span>\n            </div>\n          </div>\n\n          <p className=\"text-slate-350 text-sm leading-relaxed mb-5\">\n            \351\200\231\346\230\257\346\210\221\345\200\221\350\267\221\345\234\230\345\260\210\345\261\254\347\232\204\347\266\262\351\240\201\347\211\210\350\231\233\346\223\254\346\241\214\351\235\242\357\274\210VTT\357\274\211\344\274\272\346\234\215\345\231\250\357\274\201\350\243\241\351\235\242\345\205\247\345\273\272\344\272\206\347\262\276\347\276\216\347\232\204\350\207\252\350\250\202\345\234\260\345\234\226\343\200\201\345\213\225\346\205\213\345\205\211\346\272\220\343\200\201\350\203\214\346\231\257\351\237\263\346\250\202\344\273\245\345\217\212\345\205\250\350\207\252\345\213\225\345\214\226\347\232\204\344\272\272\347\211\251\345\215\241\343\200\202\351\273\236\346\223\212\344\270\213\346\226\271\346\214\211\351\210\225\345\215\263\345\217\257\347\233\264\346\216\245\351\226\213\345\225\237\347\200\217\350\246\275\345\231\250\347\266\262\351\240\201\357\274\214\345\212\240\345\205\245\346\210\221\345\200\221\346\263\242\347\200\276\345\243\257\351\227\212\347\232\204\345\206\222\351\232\252\344\270\226\347\225\214\357\274\201\n          </p>\n\n          {/* FVTT Server URL Box */}\n          <div className=\"bg-slate-950/80 rounded-xl border border-slate-800 p-4 mb-5\">\n            <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-widest\">\n              Tabletop Connection Link\n            </div>\n            <div className=\"flex items-center justify-between mt-1.5 gap-4\">\n              <div className=\"text-xs sm:text-sm font-mono font-semibold text-purple-300 overflow-x-auto whitespace-nowrap scrollbar-hide py-1\">\n                {info.fvttUrl}\n              </div>\n              <button \n                onClick={handleCopyFvtt}\n                className=\"px-3 py-1.5 bg-slate-900 border border-slate-800 hover:border-purple-500/30 hover:bg-slate-800 text-slate-400 hover:text-purple-300 rounded-lg text-xs font-mono transition-all flex items-center gap-1.5 shrink-0\"\n              >\n                {copiedFvtt ? (\n                  <>\n                    <Check size={12} className=\"text-emerald-400\" />\n                    <span className=\"text-emerald-400\">\345\267\262\350\244\207\350\243\275</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy size={12} />\n                    <span>\350\244\207\350\243\275</span>\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n\n          {/* Current campaign stats / showcase */}\n          <div className=\"space-y-3.5 border-t border-slate-800/80 pt-4\">\n            <h3 className=\"text-xs font-mono font-bold text-slate-400 tracking-wider uppercase\">Active Chronicles // \347\233\256\345\211\215\346\210\260\345\275\271\350\263\207\350\250\212</h3>\n            \n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div className=\"bg-slate-950/30 border border-slate-800/60 rounded-xl p-3\">\n                <div className=\"text-[10px] text-slate-500 font-mono\">\346\255\243\345\234\250\351\200\262\350\241\214\347\232\204\350\267\221\345\234\230\346\210\260\345\275\271 (Campaign)</div>\n                <div className=\"text-sm font-bold text-slate-200 mt-1 flex items-center gap-1.5\">\n                  <Bookmark size={14} className=\"text-purple-400 col-span-1\" />\n                  <span>\351\276\215\350\210\207\345\234\260\344\270\213\345\237\216\357\274\232\346\226\257\347\211\271\346\213\211\345\276\267\347\232\204\350\251\233\345\222\222</span>\n                </div>\n                <div className=\"text-[11px] text-slate-400 font-sans mt-1\">\347\233\256\345\211\215\351\200\262\345\272\246\357\274\232\347\254\254 15 \345\233\236\345\220\210 \302\267 \345\206\222\351\232\252\350\200\205 LV.7</div>\n              </div>\n\n              <div className=\"bg-slate-950/30 border border-slate-800/60 rounded-xl p-3\">\n                <div className=\"text-[10px] text-slate-500 font-mono\">\345\233\272\345\256\232\351\226\213\345\234\230\346\231\202\351\226\223 (Event Schedule)</div>\n                <div className=\"text-sm font-bold text-slate-200 mt-1 flex items-center gap-1.5\">\n                  <MapPin size={14} className=\"text-blue-400\" />\n                  <span>\346\257\217\351\200\261\345\205\255 \346\231\232\344\270\212 20:00 (UTC+8)</span>\n                </div>\n                <div className=\"text-[11px] text-slate-400 font-sans mt-1\">\351\240\220\350\250\210\351\225\267\345\272\246\357\274\232\346\257\217\347\257\200 3 ~ 4 \345\260\217\346\231\202</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"mt-6 pt-4 border-t border-slate-800/60 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4\">\n          <div className=\"text-xs text-slate-500 font-mono\">\n            \342\232\240\357\270\217 \345\273\272\350\255\260\344\275\277\347\224\250 Chrome / Edge \347\200\217\350\246\275\345\231\250\344\270\246\351\226\213\345\225\237\347\241\254\351\253\224\345\212\240\351\200\237\344\273\245\347\215\262\345\217\226\346\234\200\344\275\263\346\265\201\346\232\242\345\272\246\343\200\202\n          </div>\n          <a\n            href={info.fvttUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"px-5 py-2.5 bg-gradient-to-r from-purple-600/80 to-pink-600/80 hover:from-purple-600 hover:to-pink-600 text-white rounded-xl text-xs font-mono font-medium flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(168,85,247,0.2)] hover:shadow-[0_0_15px_rgba(168,85,247,0.5)] transition-all shrink-0 active:scale-95\"\n          >\n            <Play size={12} fill=\"white\" /> \345\202\263\351\200\201\345\210\260 FVTT \344\274\272\346\234\215\345\231\250 <ExternalLink size={12} />\n          </a>\n        </div>\n      </motion.div>\n\n      {/* TRPG Discord group banner (5 cols) */}\n      <div className=\"lg:col-span-5 flex flex-col gap-6\">\n        \n        {/* TRPG Guild Server invite block */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.5, delay: 0.1 }}\n          className=\"relative bg-slate-900/85 border border-blue-500/30 rounded-2xl p-6 backdrop-blur-md shadow-[0_0_20px_rgba(59,130,246,0.15)] flex flex-col justify-between\"\n        >\n          <div>\n            {/* Header */}\n            <div className=\"flex items-center gap-3 mb-4\">\n              <div className=\"p-2.5 bg-blue-950/50 rounded-xl border border-blue-500/30 text-blue-400\">\n                <Users size={20} />\n              </div>\n              <div>\n                <h2 className=\"text-base font-sans font-bold text-slate-100\">TRPG Discord \344\272\244\346\265\201\347\276\244</h2>\n                <p className=\"text-[10px] text-slate-400 font-mono\">TRPG Discord Syndicate Group</p>\n              </div>\n            </div>\n\n            <p className=\"text-xs text-slate-400 leading-relaxed mb-4\">\n              \351\200\231\346\230\257\346\210\221\345\200\221\350\267\221\345\234\230\347\216\251\345\256\266\343\200\201\345\234\260\344\270\213\345\237\216\345\237\216\344\270\273\357\274\210DM\357\274\211\345\222\214\351\201\212\346\210\262\344\270\273\346\214\201\344\272\272\357\274\210GM\357\274\211\347\232\204\345\244\247\346\234\254\347\207\237\343\200\202\345\234\250\351\200\231\350\243\241\346\210\221\345\200\221\347\224\250\344\276\206\351\200\262\350\241\214\357\274\232\n            </p>\n\n            {/* Bullets */}\n            <div className=\"space-y-3 pl-1 mb-6 text-xs text-slate-300 font-sans\">\n              <div className=\"flex items-center gap-2\">\n                <Sparkles size={12} className=\"text-purple-400\" />\n                <span>\351\226\213\345\234\230\346\217\252\344\272\272\357\274\210\350\267\221\345\234\230\345\244\247\345\273\263\343\200\201\350\246\217\345\211\207\346\233\270\345\260\216\350\256\200\357\274\211</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <BookOpen size={12} className=\"text-blue-400\" />\n                <span>\345\212\207\346\234\254\347\267\250\350\243\275\343\200\201TRPG \345\211\265\344\275\234\350\250\216\350\253\226\350\210\207\345\210\206\344\272\253</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <Dices size={12} className=\"text-pink-400\" />\n                <span>\351\226\213\345\234\230\347\225\266\345\244\251\347\232\204\347\224\250\350\252\236\351\237\263\350\210\207\346\226\207\345\255\227\345\215\263\346\231\202\351\200\232\350\250\212\351\240\273\351\201\223</span>\n              </div>\n            </div>\n\n            {/* Systems directory badges */}\n            <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-widest mb-3 border-t border-slate-800/80 pt-4\">\n              SUPPORTED SYSTEMS // \346\224\257\346\217\264\350\246\217\345\211\207\n            </div>\n            <div className=\"flex flex-wrap gap-1.5\">\n              <span className=\"text-[10px] px-2.5 py-0.5 bg-purple-950/20 text-purple-300 border border-purple-500/20 rounded-full font-mono\">D&D 5e</span>\n              <span className=\"text-[10px] px-2.5 py-0.5 bg-blue-950/20 text-blue-300 border border-blue-500/20 rounded-full font-mono\">CoC 7th</span>\n              <span className=\"text-[10px] px-2.5 py-0.5 bg-pink-950/20 text-pink-300 border border-pink-500/20 rounded-full font-mono\">Cyberpunk Red</span>\n              <span className=\"text-[10px] px-2.5 py-0.5 bg-slate-900 text-slate-300 border border-slate-800 rounded-full font-mono\">Delta Green</span>\n            </div>\n          </div>\n\n          <div className=\"mt-6\">\n            <a\n              href={info.trpgDiscordUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"w-full py-2.5 rounded-xl border border-blue-500/40 hover:border-blue-400 bg-blue-500/10 hover:bg-blue-500/20 text-blue-200 hover:text-white transition-all text-xs font-mono font-semibold flex items-center justify-center gap-2 shadow-[0_0_10px_rgba(59,130,246,0.1)]\"\n            >\n              \347\253\213\345\210\273\345\212\240\345\205\245 TRPG \350\250\216\350\253\226\347\276\244\347\265\204 <ExternalLink size={12} />\n            </a>\n          </div>\n        </motion.div>\n\n        {/* Dynamic lore log or chronic update text */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.5, delay: 0.2 }}\n          className=\"bg-slate-900/85 border border-slate-800 rounded-2xl p-4 backdrop-blur-md\"\n        >\n          <div className=\"flex gap-2.5\">\n            <span className=\"text-xl\">\360\237\223\234</span>\n            <div>\n              <h4 className=\"text-xs font-mono text-slate-300 font-bold\">\345\206\222\351\232\252\350\200\205\346\227\245\350\252\214 (Chronicle Log #42)</h4>\n              <p className=\"text-[11px] text-slate-400 leading-normal mt-1.5\">\n                \343\200\214\345\234\250\347\204\241\351\242\250\347\232\204\345\273\242\345\242\237\346\234\200\346\267\261\350\231\225\357\274\214\346\210\221\345\200\221\347\231\274\347\217\276\344\272\206\345\270\266\346\234\211\346\232\227\347\264\253\350\211\262\350\236\242\345\205\211\347\232\204\346\231\266\351\253\224...\351\200\231\350\210\207\345\202\263\350\252\252\344\270\255\345\264\251\346\275\260\347\232\204\347\206\224\347\210\220\346\245\265\345\205\266\347\233\270\344\274\274\343\200\202\344\270\213\351\200\261\345\205\255\357\274\214\346\210\221\345\200\221\345\277\205\351\240\210\346\203\263\350\276\246\346\263\225\347\252\201\347\240\264\351\200\231\345\261\244\351\255\224\345\212\233\347\265\220\347\225\214...\343\200\215\n              </p>\n            </div>\n          </div>\n        </motion.div>\n\n      </div>"
        replacement_content: "      {/* Foundry VTT Server console card (now 5 cols) */}\n      <motion.div \n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.5 }}\n        className=\"lg:col-span-5 relative bg-slate-900/85 border border-purple-500/30 rounded-2xl p-6 backdrop-blur-md shadow-[0_0_20px_rgba(168,85,247,0.15)] flex flex-col justify-between group\"\n      >\n        <div className=\"absolute top-0 right-0 w-24 h-24 bg-purple-500/10 rounded-full blur-2xl pointer-events-none\" />\n        \n        <div>\n          {/* Header */}\n          <div className=\"flex justify-between items-center mb-5\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-2 bg-purple-950/50 rounded-xl border border-purple-500/30 text-purple-400 group-hover:scale-105 transition-transform duration-350\">\n                <Dices size={20} />\n              </div>\n              <div>\n                <h2 className=\"text-base font-sans font-bold text-slate-100\">Foundry VTT \350\267\221\345\234\230\347\266\262\345\235\200</h2>\n                <p className=\"text-[10px] text-slate-400 font-mono\">Foundry Virtual Tabletop</p>\n              </div>\n            </div>\n            \n            {/* Table status indicator */}\n            <div className=\"flex items-center gap-2 bg-emerald-950/40 px-2.5 py-1 rounded-full border border-emerald-500/30\">\n              <span className=\"h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n              <span className=\"text-[10px] font-mono text-emerald-400 uppercase tracking-widest font-semibold\">Active</span>\n            </div>\n          </div>\n\n          <p className=\"text-slate-350 text-xs leading-relaxed mb-5\">\n            \351\200\231\346\230\257\346\210\221\345\200\221\345\260\210\345\261\254\347\232\204\347\266\262\351\240\201\347\211\210\350\231\233\346\223\254\346\241\214\351\235\242\357\274\210VTT\357\274\211\344\274\272\346\234\215\345\231\250\357\274\201\345\205\247\345\273\272\347\262\276\347\276\216\350\207\252\350\250\202\345\234\260\345\234\226\343\200\201\345\213\225\346\205\213\345\205\211\346\272\220\343\200\201\350\203\214\346\231\257\351\237\263\346\250\202\344\273\245\345\217\212\345\205\250\350\207\252\345\213\225\344\272\272\347\211\251\345\215\241\343\200\202\n          </p>\n\n          {/* FVTT Server URL Box */}\n          <div className=\"bg-slate-950/80 rounded-xl border border-slate-800 p-4 mb-5\">\n            <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-widest\">\n              Tabletop Connection Link\n            </div>\n            <div className=\"flex items-center justify-between mt-1.5 gap-4\">\n              <div className=\"text-xs font-mono font-semibold text-purple-300 overflow-x-auto whitespace-nowrap scrollbar-hide py-1\">\n                {info.fvttUrl}\n              </div>\n              <button \n                onClick={handleCopyFvtt}\n                className=\"px-3 py-1.5 bg-slate-900 border border-slate-800 hover:border-purple-500/30 hover:bg-slate-800 text-slate-400 hover:text-purple-300 rounded-lg text-xs font-mono transition-all flex items-center gap-1.5 shrink-0\"\n              >\n                {copiedFvtt ? (\n                  <>\n                    <Check size={12} className=\"text-emerald-400\" />\n                    <span className=\"text-emerald-400\">\345\267\262\350\244\207\350\243\275</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy size={12} />\n                    <span>\350\244\207\350\243\275</span>\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n\n          {/* Current campaign stats / showcase */}\n          <div className=\"space-y-3.5 border-t border-slate-800/80 pt-4\">\n            <h3 className=\"text-xs font-mono font-bold text-slate-400 tracking-wider uppercase\">Active Chronicles // \346\210\260\345\275\271\350\263\207\350\250\212</h3>\n            \n            <div className=\"space-y-3\">\n              <div className=\"bg-slate-950/30 border border-slate-800/65 rounded-xl p-3\">\n                <div className=\"text-[10px] text-slate-500 font-mono\">\346\210\260\345\275\271 (Campaign)</div>\n                <div className=\"text-xs font-bold text-slate-200 mt-1 flex items-center gap-1.5\">\n                  <Bookmark size={13} className=\"text-purple-400 shrink-0\" />\n                  <span className=\"truncate\">\351\276\215\350\210\207\345\234\260\344\270\213\345\237\216\357\274\232\346\226\257\347\211\271\346\213\211\345\276\267\347\232\204\350\251\233\345\222\222</span>\n                </div>\n                <div className=\"text-[10px] text-slate-400 font-sans mt-0.5\">\351\200\262\345\272\246\357\274\232\347\254\254 15 \345\233\236\345\220\210 \302\267 \345\206\222\351\232\252\350\200\205 LV.7</div>\n              </div>\n\n              <div className=\"bg-slate-950/30 border border-slate-800/65 rounded-xl p-3\">\n                <div className=\"text-[10px] text-slate-500 font-mono\">\346\231\202\351\226\223 (Event Schedule)</div>\n                <div className=\"text-xs font-bold text-slate-200 mt-1 flex items-center gap-1.5\">\n                  <MapPin size={13} className=\"text-blue-400 shrink-0\" />\n                  <span>\346\257\217\351\200\261\345\205\255 \346\231\232\344\270\212 20:00 (UTC+8)</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"mt-5 pt-4 border-t border-slate-800/60 flex flex-col gap-3\">\n          <a\n            href={info.fvttUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"w-full py-2.5 bg-gradient-to-r from-purple-600/80 to-pink-600/80 hover:from-purple-600 hover:to-pink-600 text-white rounded-xl text-xs font-mono font-medium flex items-center justify-center gap-2 shadow-[0_0_15px_rgba(168,85,247,0.2)] hover:shadow-[0_0_15px_rgba(168,85,247,0.5)] transition-all shrink-0 active:scale-95\"\n          >\n            <Play size={11} fill=\"white\" /> \345\202\263\351\200\201\345\210\260 FVTT \344\274\272\346\234\215\345\231\250 <ExternalLink size={11} />\n          </a>\n          <div className=\"text-[10px] text-slate-500 font-mono text-center\">\n            * \345\273\272\350\255\260\344\275\277\347\224\250 Chrome / Edge \347\200\217\350\246\275\345\231\250\343\200\202\n          </div>\n        </div>\n      </motion.div>\n\n      {/* TRPG Discord group banner (now 7 cols) */}\n      <div className=\"lg:col-span-7 flex flex-col gap-6\">\n        \n        {/* TRPG Guild Server invite block with inner responsive split columns */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.5, delay: 0.1 }}\n          className=\"relative bg-slate-900/85 border border-blue-500/30 rounded-2xl p-6 backdrop-blur-md shadow-[0_0_20px_rgba(59,130,246,0.15)]\"\n        >\n          <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n            \n            {/* Left part: Details and Buttons */}\n            <div className=\"md:col-span-7 flex flex-col justify-between\">\n              <div>\n                {/* Header */}\n                <div className=\"flex items-center gap-3 mb-4\">\n                  <div className=\"p-2.5 bg-blue-950/50 rounded-xl border border-blue-500/30 text-blue-400\">\n                    <Users size={20} />\n                  </div>\n                  <div>\n                    <h2 className=\"text-base font-sans font-bold text-slate-100\">TRPG Discord \344\272\244\346\265\201\347\276\244</h2>\n                    <p className=\"text-[10px] text-slate-400 font-mono\">TRPG Discord Syndicate Group</p>\n                  </div>\n                </div>\n\n                <p className=\"text-xs text-slate-400 leading-relaxed mb-4\">\n                  \351\200\231\346\230\257\346\210\221\345\200\221\347\216\251\345\256\266\343\200\201DM (\345\234\260\344\270\213\345\237\216\345\237\216\344\270\273) \345\222\214 GM (\351\201\212\346\210\262\344\270\273\346\214\201\344\272\272) \347\232\204\347\270\275\351\203\250\343\200\202\346\210\221\345\200\221\345\234\250\351\200\231\350\243\241\351\200\262\350\241\214\357\274\232\n                </p>\n\n                {/* Bullets */}\n                <div className=\"space-y-3.5 pl-1 mb-5 text-xs text-slate-300 font-sans\">\n                  <div className=\"flex items-center gap-2\">\n                    <Sparkles size={12} className=\"text-purple-400 shrink-0\" />\n                    <span>\351\226\213\345\234\230\346\217\252\344\272\272\357\274\210\350\267\221\345\234\230\345\244\247\345\273\263\343\200\201\345\260\210\346\245\255\350\246\217\345\211\207\346\233\270\345\260\216\350\256\200\357\274\211</span>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <BookOpen size={12} className=\"text-blue-400 shrink-0\" />\n                    <span>\345\212\207\346\234\254\347\267\250\350\243\275\343\200\201TRPG \345\211\265\344\275\234\350\250\216\350\253\226\350\210\207\350\263\207\346\272\220\345\210\206\344\272\253</span>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <Dices size={12} className=\"text-pink-400 shrink-0\" />\n                    <span>\350\267\221\345\234\230\347\225\266\345\244\251\347\232\204\351\253\230\351\237\263\350\263\252\350\252\236\351\237\263\350\210\207\345\215\263\346\231\202\346\273\276\351\252\260\351\240\273\351\201\223</span>\n                  </div>\n                </div>\n\n                {/* Systems directory badges */}\n                <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-widest mb-3 border-t border-slate-800/80 pt-4\">\n                  SUPPORTED SYSTEMS // \346\224\257\346\217\264\350\246\217\345\211\207\n                </div>\n                <div className=\"flex flex-wrap gap-1.5 mb-4\">\n                  <span className=\"text-[10px] px-2.5 py-0.5 bg-purple-950/20 text-purple-300 border border-purple-500/20 rounded-full font-mono\">D&D 5e</span>\n                  <span className=\"text-[10px] px-2.5 py-0.5 bg-blue-950/20 text-blue-300 border border-blue-500/20 rounded-full font-mono\">CoC 7th</span>\n                  <span className=\"text-[10px] px-2.5 py-0.5 bg-pink-950/20 text-pink-300 border border-pink-500/20 rounded-full font-mono\">Cyberpunk Red</span>\n                </div>\n              </div>\n\n              <div>\n                <a\n                  href={info.trpgDiscordUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"w-full py-2.5 rounded-xl border border-blue-500/40 hover:border-blue-400 bg-blue-500/10 hover:bg-blue-500/20 text-blue-200 hover:text-white transition-all text-xs font-mono font-semibold flex items-center justify-center gap-2 shadow-[0_0_10px_rgba(59,130,246,0.1)]\"\n                >\n                  \347\253\213\345\210\273\345\212\240\345\205\245 TRPG \350\250\216\350\253\226\347\276\244\347\265\204 <ExternalLink size={12} />\n                </a>\n              </div>\n            </div>\n\n            {/* Right part: Live Discord Widget Embedded Element */}\n            <div className=\"md:col-span-5 flex flex-col justify-between\">\n              <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-widest mb-2.5 flex items-center justify-between\">\n                <span>Live Server // \347\267\232\344\270\212\345\260\217\345\267\245\345\205\267</span>\n                <span className=\"h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse inline-block\" />\n              </div>\n\n              {info.discordServerWidgetId ? (\n                <div className=\"rounded-xl overflow-hidden border border-slate-800 relative bg-slate-950 h-[260px] shadow-[inset_0_0_10px_rgba(0,0,0,0.8)]\">\n                  <iframe\n                    src={`https://discord.com/widget?id=${info.discordServerWidgetId}&theme=dark`}\n                    width=\"100%\"\n                    height=\"100%\"\n                    allowtransparency=\"true\"\n                    frameBorder=\"0\"\n                    sandbox=\"allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts\"\n                    className=\"absolute inset-0 w-full h-full\"\n                  />\n                </div>\n              ) : (\n                <div className=\"rounded-xl border border-dashed border-slate-800 p-4 h-[260px] flex flex-col items-center justify-center text-center bg-slate-950/30\">\n                  <div className=\"text-xl mb-1\">\360\237\222\254</div>\n                  <div className=\"text-xs font-semibold text-slate-350\">\346\234\252\351\205\215\347\275\256 Discord Widget ID</div>\n                  <p className=\"text-[10px] text-slate-500 leading-normal max-w-[150px] mt-1.5\">\n                    \350\253\213\351\273\236\351\201\270\345\217\263\344\270\212\350\247\222\343\200\214\350\207\252\350\250\202\350\263\207\350\250\212\343\200\215\345\241\253\345\257\253\346\202\250\347\232\204 Discord Server ID \344\273\245\345\225\237\347\224\250\347\266\262\351\240\201\345\215\263\346\231\202\347\213\200\346\205\213\343\200\202\n                  </p>\n                </div>\n              )}\n\n              <div className=\"text-[9px] text-slate-500 font-mono leading-none text-right mt-2\">\n                STATUS FEED // DISCORD API\n              </div>\n            </div>\n\n          </div>\n        </motion.div>\n \n        {/* Dynamic lore log or chronic update text */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.5, delay: 0.2 }}\n          className=\"bg-slate-900/85 border border-slate-800 rounded-2xl p-4 backdrop-blur-md\"\n        >\n          <div className=\"flex gap-2.5\">\n            <span className=\"text-xl\">\360\237\223\234</span>\n            <div>\n              <h4 className=\"text-xs font-mono text-slate-300 font-bold\">\345\206\222\351\232\252\350\200\205\346\227\245\350\252\214 (Chronicle Log #42)</h4>\n              <p className=\"text-[11px] text-slate-400 leading-normal mt-1.5\">\n                \343\200\214\345\234\250\347\204\241\351\242\250\347\232\204\345\273\242\345\242\237\346\234\200\346\267\261\350\231\225\357\274\214\346\210\221\345\200\221\347\231\274\347\217\276\344\272\206\345\270\266\346\234\211\346\232\227\347\264\253\350\211\262\350\236\242\345\205\211\347\232\204\346\231\266\351\253\224...\351\200\231\350\210\207\345\202\263\350\252\252\344\270\255\347\267\232\346\242\235\345\264\251\346\275\260\347\232\204\347\206\224\347\210\220\346\245\265\345\205\266\347\233\270\344\274\274\343\200\202\344\270\213\351\200\261\345\205\255\357\274\214\346\210\221\345\200\221\345\277\205\351\240\210\346\203\263\350\276\246\346\263\225\347\252\201\347\240\264\351\200\231\345\261\244\351\255\224\345\212\233\347\265\220\347\225\214...\343\200\215\n              </p>\n            </div>\n          </div>\n        </motion.div>\n\n      </div>"
      }
