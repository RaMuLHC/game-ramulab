  planner_response {
    modified_response: "\346\210\221\345\267\262\345\260\207\343\200\214**Discord \345\270\263\350\231\237**\343\200\215\343\200\201\343\200\214**\345\260\210\345\261\254 Discord \350\252\236\351\237\263\344\274\272\346\234\215\345\231\250**\343\200\215\350\210\207\343\200\214**Steam \345\200\213\344\272\272\351\246\226\351\240\201**\343\200\215\347\255\211\347\233\270\351\227\234\347\244\276\347\276\244\350\210\207\351\200\232\350\250\212\345\260\217\345\267\245\345\205\267\357\274\214\346\210\220\345\212\237\345\276\236 About me\357\274\210\351\227\234\346\226\274\346\210\221\357\274\211\345\210\206\351\240\201\357\274\214\345\256\214\346\225\264\344\270\224\346\265\201\346\232\242\345\234\260\351\201\267\347\247\273\347\247\273\350\207\263 **Video games\357\274\210\351\233\273\345\255\220\351\201\212\346\210\262\357\274\211\345\210\206\351\240\201**\347\232\204\346\234\200\344\270\213\346\226\271\357\274\232\n\n### \360\237\233\240\357\270\217 \351\201\267\347\247\273\350\210\207\344\275\210\345\261\200\345\204\252\345\214\226\n* **\351\227\234\346\226\274\346\210\221\357\274\210About me\357\274\211\345\210\206\351\240\201**\357\274\232Bio \344\270\273\345\215\241\347\211\207\345\267\262\345\256\214\347\276\216\345\261\225\351\226\213\347\202\272\345\205\250\345\257\254\347\211\210\351\235\242\357\274\214\345\270\266\344\276\206\346\233\264\345\212\240\345\244\247\346\260\243\343\200\201\344\271\276\346\267\250\347\232\204\350\246\226\350\246\272\347\225\231\347\231\275\343\200\202\n* **\351\233\273\345\255\220\351\201\212\346\210\262\357\274\210Video games\357\274\211\345\210\206\351\240\201**\357\274\232\n  * \345\234\250\344\270\213\346\226\271\345\205\250\346\226\260\351\226\213\351\227\242\344\272\206 **\343\200\214\350\201\257\347\265\241\350\210\207\347\244\276\347\276\244 // Connections & Socials\343\200\215** \345\260\210\345\261\254\345\215\200\345\241\212\357\274\214\350\210\207\344\270\212\346\226\271\347\232\204 Minecraft \344\273\245\345\217\212 Rio