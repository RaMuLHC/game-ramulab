mibold flex items-center justify-center gap-2 shadow-[0_0_10px_rgba(59,130,246,0.1)]\"\n            >\n              \347\253\213\345\210\273\345\212\240\345\205\245 TRPG \350\250\216\350\253\226\347\276\244\347\265\204 <ExternalLink size={12} />\n            </a>\n          </div>\n        </motion.div>\n\n        {/* Dynamic lore log or chronic update text */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.5, delay: 0.2 }}\n          className=\"bg-slate-900/85 border border-slate-800 rounded-2xl p-4 backdrop-blur-md\"\n        >\n          <div className=\"flex gap-2.5\">\n            <span className=\"text-xl\">\360\237\223\234</span>\n            <div>\n              <h4 className=\"text-xs font-mono text-slate-300 font-bold\">\345\206\222\351\232\252\350\200\205\346\227\245\350\252\214 (Chronicle Log #42)</h4>\n              <p className=\"text-[11px] text-slate-400 leading-normal mt-1.5\">\n                \343\200\214\345\234\250\347\204\241\351\242\250\347\232\204\345\273\242\345\242\237\346\234\200\346\267\261\350\231\225\357\274\214\346\210\221\345\200\221\347\231\274\347\217\276\344\272\206\345\270\266\346\234\211\346\232\227\347\264\253\350\211\262\350\236\242\345\205\211\347\232\204\346\231\266\351\253\224...\351\200\231\350\210\207\345\202\263\350\252\252\344\270\255\345\264\251\346\275\260\347\232\204\347\206\224\347\210\220\346\245\265\345\205\266\347\233\270\344\274\274\343\200\202\344\270\213\351\200\261\345\205\255\357\274\214\346\210\221\345\200\221\345\277\205\351\240\210\346\203\263\350\276\246\346\263\225\347\252\201\347\240\264\351\200\231\345\261\244\351\255\224\345\212\233\347\265\220\347\225\214...\343\200\215\n              </p>\n            </div>\n          </div>\n        </motion.div>\n\n      </div>"
      replacement_content: "      {/* Foundry VTT Server console card (now 5 cols) */}\n      <motion.div \n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.5 }}\n        className=\"lg:col-span-5 relative bg-slate-900/85 border border-purple-500/30 rounded-2xl p-6 backdrop-blur-md shadow-[0_0_20px_rgba(168,85,247,0.15)] flex flex-col justify-between group\"\n      >\n        <div className=\"absolute top-0 right-0 w-24 h-24 bg-purple-500/10 rounded-full blur-2xl pointer-events-none\" />\n        \n        <div>\n          {/* Header */}\n          <div className=\"flex justify-between items-center mb-5\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-2 bg-purple-950/50 rounded-xl border border-purple-500/30 text-purple-400 group-hover:scale-105 transition-transform duration-350\">\n                <Dices size={20} />\n              </div>\n              <div>\n                <h2 className=\"text-base font-sans font-bold text-slate-100\">Foundry VTT \350\267\221\345\234\230\347\266\262\345\235\200</h2>\n                <p className=\"text-[10px] text-slate-400 font-mono\">Foundry Virtual Tabletop</p>\n              </div>\n            </div>\n            \n            {/* Table status indicator */}\n            <div className=\"flex items-center gap-2 bg-emerald-950/40 px-2.5 py-1 rounded-full border border-emerald-500/30\">\n              <span className=\"h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse\" />\n              <span className=\"text-[10px] font-mono text-emerald-400 uppercase tracking-widest font-semibold\">Active</span>\n            </div>\n          </div>\n\n          <p className=\"text-slate-350 text-xs leading-relaxed mb-5\">\n            \351\200\231\346\230\257\346\210\221\345\200\221\345\260\210\345\261\254\347\232\204\347\266\262\351\240\201\347\211\210\350\231\233\346\223\254\346\241\214\351\235\242\357\274\210VTT\357\274\211\344\274\272\346\234\215\345\231\250\357\274\201\345\205\247\345\273\272\347\262\276\347\276\216\350\207\252\350\250\202\345\234\260\345\234\226\343\200\201\345\213\225\346\205\213\345\205\211\346\272\220\343\200\201\350\203\214\346\231\257\351\237\263\346\250\202\344\273\245\345\217\212\345\205\250\350\207\252\345\213\225\344\272\272\347\211\251\345\215\241\343\200\202\n          </p>\n\n          {/* FVTT Server URL Box */}\n          <div className=\"bg-slate-950/80 rounded-xl border border-slate-800 p-4 mb-5\">\n            <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-widest\">\n              Tabletop Connection Link\n            </div>\n            <div className=\"flex items-center justify-between mt-1.5 gap-4\">\n              <div className=\"text-xs font-mono font-semibold text-purple-300 overflow-x-auto whitespace-nowrap scrollbar-hide py-1\">\n                {info.fvttUrl}\n              </div>\n              <button \n                onClick={handleCopyFvtt}\n                className=\"px-3 py-1.5 bg-slate-900 border border-slate-800 hover:border-purple-500/30 hover:bg-slate-800 text-slate-400 hover:text-purple-300 rounded-lg text-xs font-mono transition-all flex items-center gap-1.5 shrink-0\"\n              >\n                {copiedFvtt ? (\n                  <>\n                    <Check size={12} className=\"text-emerald-400\" />\n                    <span className=\"text-emerald-400\">\345\267\262\350\244\207\350\243\275</span>\n                  </>\n                ) : (\n                  <>\n                    <Copy size={12} />\n                    <span>\350\244\207\350\243\275</span>\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n\n          {/* Current campaign stats / showcase */}\n          <div className=\"space-y-3.5 border-t border-slate-800/80 pt-4\">\n            <h3 className=\"text-xs font-mono font-bold text-slate-400 tracking-wider uppercase\">Active Chronicles // \346\210\260\345\275\271\350\263\207\350\250\212</h3>\n            \n            <div className=\"space-y-3\">\n              <div className=\"bg-slate-950/30 border border-slate-800/65 rounded-xl p-3\">\n                <div className=\"text-[10px] text-slate-500 font-mono\">\346\210\260\345\275\271 (Campaign)</div>\n                <div className=\"text-xs font-bold text-slate-200 mt-1 flex items-center gap-1.5\">\n                  <Bookmark size={13} className=\"text-purple-400 shrink-0\" />\n                  <span className=\"truncate\">\351\276\215\350\210\207\345\234\260\344\270\213\345\237\216\357\274\232\346\226\257\347\211\271\346\213\211\345\276\267\347\232\204\350\251\233\345\222\222</span>\n                </div>\n                <div className=\"text-[10px] text-slate-400 font-sans mt-0.5\">\351\200\262\345\272\246\357\274\232\347\254\254 15 \345\233\236\345\220\210 \302\267 \345\206\222\351\232\252\350\200\205 LV.7</div>\n              </div>\n\n              <div className=\"bg-slate-950/30 border border-slate-800/65 rounded-xl p-3\">\n                <div className=\"text-[10px] text-slate-500 font-mono\">\346\231\202\351\226\223 (Event Schedule)</div>\n                <div className=\"text-xs font-bold text-slate-200 mt-1 flex items-center gap-1.5\">\n                  <MapPin size={13} className=\"text-blue-400 shrink-0\" />\n                  <span>\346\257\217\351\200\261\345\205\255 \346\231\232\344\270\212 20:00 (UTC+8)</span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"mt-5 pt-4 border-t border-slate-800/60 flex flex-col gap-3\">\n          <a\n            href={info.fvttUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"w-full py-2.5 bg-gradient-to-r from-purple-600/80 to-pink-600/80 hover:from-purple-600 hover:to-pink-600 text-white rounded-xl text-xs font-mono font-medium flex it