    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion } from \'motion/react\';\nimport { Copy, Check, ExternalLink, Gamepad2, Award, Users, Ship, Heart, Compass } from \'lucide-react\';\nimport { GameInformation } from \'../types\';\n\ninterface AboutTabProps {\n  info: GameInformation;\n}\n\nexport default function AboutTab({ info }: AboutTabProps) {\n  const [copied, setCopied] = useState(false);\n\n  const copyToClipboard = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto\">\n      {/* Bio Card (2/3 width on desktop) */}\n      <motion.div \n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        transition={{ duration: 0.5 }}\n        className=\"md:col-span-2 relative group overflow-hidden bg-slate-900/80 border border-purple-500/30 rounded-2xl p-6 md:p-8 backdrop-blur-md shadow-[0_0_15px_rgba(168,85,247,0.15)] flex flex-col justify-between\"\n      >\n        <div className=\"absolute top-0 right-0 w-32 h-32 bg-purple-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-purple-500/20 transition-all duration-500\" />\n        <div className=\"absolute -bottom-8 -left-8 w-24 h-24 bg-blue-500/10 rounded-full blur-2xl pointer-events-none\" />\n        \n        {/* Animated Scanline overlay */}\n        <div className=\"absolute inset-0 bg-linear-to-b from-transparent via-cyan-500/5 to-transparent h-1/4 w-full -translate-y-full group-hover:translate-y-[400%] transition-transform duration-[3s] ease-linear pointer-events-none\" />\n\n        <div>\n          {/* Header */}\n          <div className=\"flex items-center gap-3 mb-4\">\n            <span className=\"flex h-3 w-3 relative\">\n              <span className=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75\"></span>\n              <span className=\"relative inline-flex rounded-full h-3 w-3 bg-purple-500\"></span>\n            </span>\n            <div className=\"text-xs font-mono text-purple-400 tracking-widest uppercase\">Gamer Profile // Active</div>\n          </div>\n          \n          <h1 className=\"text-3xl md:text-4xl font-sans font-bold tracking-tight bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 bg-clip-text text-transparent mb-4\">\n            {info.gamerTag}\n          </h1>\n          \n          <p className=\"text-slate-300 text-sm md:text-base leading-relaxed font-sans mb-6\">\n            {info.aboutText}\n          </p>\n        </div>\n\n        {/* Quick Tech Stats */}\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-3 pt-4 border-t border-slate-800\">\n          <div className=\"bg-slate-950/50 p-3 rounded-lg border border-purple-950/50\">\n            <div className=\"text-xs text-slate-500 font-mono\">\346\210\260\345\212\233\347\264\232\345\210\245</div>\n            <div className=\"text-sm font-semibold text-purple-300 font-mono mt-1\">LV.99 Veteran</div>\n          </div>\n          <div className=\"bg-slate-950/50 p-3 rounded-lg border border-purple-950/50\">\n            <div className=\"text-xs text-slate-500 font-mono\">\344\270\273\350\246\201\346\264\273\345\213\225</div>\n            <div className=\"text-sm font-semibold text-blue-300 font-mono mt-1\">Sandbox / TTRPG</div>\n          </div>\n          <div className=\"bg-slate-950/50 p-3 rounded-lg border border-purple-950/50 col-span-2 sm:col-span-1\">\n            <div className=\"text-xs text-slate-500 font-mono\">\351\200\243\347\267\232\347\213\200\346\205\213</div>\n            <div className=\"text-sm font-semibold text-emerald-400 font-mono mt-1 flex items-center gap-1.5\">\n              <span className=\"h-2 w-2 rounded-full bg-emerald-400 animate-pulse\" />\n              Online Now\n            </div>\n          </div>\n        </div>\n      </motion.div>\n\n      {/* Profile Sidebar Quick Information widgets */}\n      <div className=\"flex flex-col gap-6\">\n        \n        {/* Discord Account Widget */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.5, delay: 0.1 }}\n          className=\"relative bg-slate-900/80 border border-blue-500/30 rounded-2xl p-5 backdrop-blur-md shadow-[0_0_15px_rgba(59,130,246,0.15)] group\"\n        >\n          <div className=\"flex items-start justify-between\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-2.5 bg-blue-950/50 rounded-xl border border-blue-500/30 text-blue-400 group-hover:scale-110 transition-transform duration-350\">\n                <Users size={20} />\n              </div>\n              <div>\n                <div className=\"text-xs font-mono text-blue-400\">Discord \345\270\263\350\231\237</div>\n                <div className=\"text-sm font-mono font-medium text-slate-200 mt-0.5\">{info.discordUsername}</div>\n              </div>\n            </div>\n            \n            <button \n              onClick={() => copyToClipboard(info.discordUsername)}\n              className=\"p-1 px-2.5 rounded-lg text-xs font-mono border bg-slate-950 border-slate-800 text-slate-400 hover:text-blue-400 hover:border-blue-500/40 transition-colors flex items-center gap-1 active:scale-95\"\n            >\n              {copied ? (\n                <>\n                  <Check size={12} className=\"text-emerald-400\" />\n                  <span className=\"text-emerald-400\">\345\267\262\350\244\207\350\243\275</span>\n                </>\n              ) : (\n                <>\n                  <Copy size={12} />\n                  <span>\350\244\207\350\243\275</span>\n                </>\n              )}\n            </button>\n          </div>\n          <div className=\"text-xs text-slate-400 mt-3 bg-slate-950/40 p-2.5 rounded-lg border border-slate-800/60 leading-normal\">\n            \351\273\236\351\201\270\346\214\211\351\210\225\350\244\207\350\243\275\344\275\277\347\224\250\350\200\205 ID\357\274\214\345\215\263\345\217\257\345\234\250 Discord \346\220\234\345\260\213\344\270\246\345\212\240\346\210\221\347\202\272\345\245\275\345\217\213\357\274\201\n          </div>\n        </motion.div>\n\n        {/* Discord Server Widget */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.5, delay: 0.2 }}\n          className=\"relative bg-slate-900/80 border border-purple-500/30 rounded-2xl p-5 backdrop-blur-md shadow-[0_0_15px_rgba(168,85,247,0.15)] group\"\n        >\n          <div className=\"flex items-center gap-3 mb-3\">\n            <div className=\"p-2.5 bg-purple-950/50 rounded-xl border border-purple-500/30 text-purple-400 group-hover:scale-110 transition-transform duration-350\">\n              <Gamepad2 size={20} />\n            </div>\n            <div>\n              <div className=\"text-xs font-mono text-purple-400\">\345\260\210\345\261\254 Discord \350\252\236\351\237\263\344\274\272\346\234\215\345\231\250</div>\n              <div className=\"text-sm font-sans font-bold text-slate-200 mt-0.5\">RAMULAB Gaming Lab</div>\n            </div>\n          </div>\n          <p className=\"text-slate-400 text-xs leading-normal mb-4\">\n            \351\200\231\346\230\257\346\210\221\345\200\221\347\265\204\345\234\230\345\223\210\346\213\211\343\200\201\351\226\213\351\273\221\351\200\232\350\251\261\343\200\201\345\210\206\344\272\253\346\224\273\347\225\245\347\232\204\347\247\230\345\257\206\345\237\272\345\234\260\343\200\202\347\233\264\346\216\245\351\273\236\346\223\212\351\200\243\347\265\220\345\215\263\345\217\257\346\220\255\344\271\230\345\202\263\351\200\201\351\226\200\351\200\262\345\205\245\343\200\202\n          </p>\n          <a\n            href={info.discordServerUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"w-full py-2.5 rounded-xl border border-purple-500/40 hover:border-purple-400 bg-purple-500/10 hover:bg-purple-500/20 text-purple-200 hover:text-white transition-all text-xs font-mono font-medium flex items-center justify-center gap-2\"\n          >\n            \345\212\240\345\205\245\350\252\236\351\237\263\347\276\244\347\265\204 <ExternalLink size={12} />\n          </a>\n        </motion.div>\n\n        {/* Steam Profile Link card */}\n        <motion.div \n          initial={{ opacity: 0, x: 20 }}\n          animate={{ opacity: 1, x: 0 }}\n          transition={{ duration: 0.5, delay: 0.3 }}\n          className=\"relative bg-slate-900/80 border border-blue-500/30 rounded-2xl p-5 backdrop-blur-md shadow-[0_0_15px_rgba(59,130,246,0.15)] group\"\n        >\n          <div className=\"flex items-center gap-3 mb-3\">\n            <div className=\"p-2.5 bg-blue-950/50 rounded-xl border border-blue-500/30 text-blue-400 group-hover:scale-110 transition-transform duration-350\">\n              <Compass size={20} />\n            </div>\n            <div>\n              <div className=\"text-xs font-mono text-blue-400\">Steam \345\200\213\344\272\272\351\246\226\351\240\201</div>\n              <div className=\"text-sm font-sans font-bold text-slate-200 mt-0.5\">Steam \345\206\222\351\232\252\350\200\205\351\240\201\351\235\242</div>\n            </div>\n          </div>\n          <p className=\"text-slate-400 text-xs leading-normal mb-4\">\n            \351\232\250\346\231\202\346\237\245\351\226\261\346\210\221\347\232\204 Steam \351\201\212\346\210\262\346\270\205\345\226\256\343\200\201\346\224\266\350\227\217\345\272\253\343\200\201\350\243\235\345\202\231\346\210\220\345\260\261\357\274\214\346\210\226\347\231\274\351\200\201\345\245\275\345\217\213\351\202\200\350\253\213\347\265\246\346\210\221\343\200\202\n          </p>\n          <a\n            href={info.steamUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"w-full py-2.5 rounded-xl border border-blue-500/40 hover:border-blue-400 bg-blue-500/10 hover:bg-blue-500/20 text-blue-200 hover:text-white transition-all text-xs font-mono font-medium flex items-center justify-center gap-2\"\n          >\n            \345\211\215\345\276\200 Steam \345\200\213\344\272\272\351\240\201\351\235\242 <ExternalLink size={12} />\n          </a>\n        </motion.div>\n      </div>\n    </div>\n  );\n}\n"
    }
