text-xs text-slate-400 leading-relaxed mb-4\">\n                  \351\200\231\346\230\257\346\210\221\345\200\221\347\216\251\345\256\266\343\200\201DM (\345\234\260\344\270\213\345\237\216\345\237\216\344\270\273) \345\222\214 GM (\351\201\212\346\210\262\344\270\273\346\214\201\344\272\272) \347\232\204\347\270\275\351\203\250\343\200\202\346\210\221\345\200\221\345\234\250\351\200\231\350\243\241\351\200\262\350\241\214\357\274\232\n                </p>\n\n                {/* Bullets */}\n                <div className=\"space-y-3.5 pl-1 mb-5 text-xs text-slate-300 font-sans\">\n                  <div className=\"flex items-center gap-2\">\n                    <Sparkles size={12} className=\"text-purple-400 shrink-0\" />\n                    <span>\351\226\213\345\234\230\346\217\252\344\272\272\357\274\210\350\267\221\345\234\230\345\244\247\345\273\263\343\200\201\345\260\210\346\245\255\350\246\217\345\211\207\346\233\270\345\260\216\350\256\200\357\274\211</span>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <BookOpen size={12} className=\"text-blue-400 shrink-0\" />\n                    <span>\345\212\207\346\234\254\347\267\250\350\243\275\343\200\201TRPG \345\211\265\344\275\234\350\250\216\350\253\226\350\210\207\350\263\207\346\272\220\345\210\206\344\272\253</span>\n                  </div>\n                  <div className=\"flex items-center gap-2\">\n                    <Dices size={12} className=\"text-pink-400 shrink-0\" />\n                    <span>\350\267\221\345\234\230\347\225\266\345\244\251\347\232\204\351\253\230\351\237\263\350\263\252\350\252\236\351\237\263\350\210\207\345\215\263\346\231\202\346\273\276\351\252\260\351\240\273\351\201\223</span>\n                  </div>\n                </div>\n\n                {/* Systems directory badges */}\n                <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-widest mb-3 border-t border-slate-800/80 pt-4\">\n                  SUPPORTED SYSTEMS // \346\224\257\346\217\264\350\246\217\345\211\207\n                </div>\n                <div className=\"flex flex-wrap gap-1.5 mb-4\">\n                  <span className=\"text-[10px] px-2.5 py-0.5 bg-purple-950/20 text-purple-300 border border-purple-500/20 rounded-full font-mono\">D&D 5e</span>\n                  <span className=\"text-[10px] px-2.5 py-0.5 bg-blue-950/20 text-blue-300 border border-blue-500/20 rounded-full font-mono\">CoC 7th</span>\n                  <span className=\"text-[10px] px-2.5 py-0.5 bg-pink-950/20 text-pink-300 border border-pink-500/20 rounded-full font-mono\">Cyberpunk Red</span>\n                </div>\n              </div>\n\n              <div>\n                <a\n                  href={info.trpgDiscordUrl}\n                  target=\"_blank\"\n                  rel=\"noopener noreferrer\"\n                  className=\"w-full py-2.5 rounded-xl border border-blue-500/40 hover:border-blue-400 bg-blue-500/10 hover:bg-blue-500/20 text-blue-200 hover:text-white transition-all text-xs font-mono font-semibold flex items-center justify-center gap-2 shadow-[0_0_10px_rgba(59,130,246,0.1)]\"\n                >\n                  \347\253\213\345\210\273\345\212\240\345\205\245 TRPG \350\250\216\350\253\226\347\276\244\347\265\204 <ExternalLink size={12} />\n                </a>\n              </div>\n            </div>\n\n            {/* Right part: Live Discord Widget Embedded Element */}\n            <div className=\"md:col-span-5 flex flex-col justify-between\">\n              <div className=\"text-[10px] text-slate-500 font-mono uppercase tracking-widest mb-2.5 flex items-center justify-between\">\n                <span>Live Server // \347\267\232\344\270\212\345\260\217\345\267\245\345\205\267</span>\n                <span className=\"h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse inline-block\" />\n              </div>\n\n              {info.discordServerWidgetId ? (\n    